            "url": {
              "raw": "{{baseUrl}}/api/v1/estoque/{{produtoIdValido}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estoque", "{{produtoIdValido}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('atualizadoEm tem offset de timezone explicito', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.atualizadoEm).to.match(/[+-]\\d{2}:\\d{2}$/);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
