            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));",
                  "pm.test('ApiError tem status 403', () => pm.response.json().status === 403);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Catalogo publico (sem autenticacao)",
      "item": [
        {
          "name": "GET /public/produtos - sem header -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/public/produtos", "host": ["{{baseUrl}}"], "path": ["api", "v1", "public", "produtos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Itens nao expoem quantidadeDisponivel exata nem fornecedorId', () => {",
                  "  const body = pm.response.json();",
                  "  for (const item of body.content) {",
                  "    pm.expect(item).to.not.have.property('quantidadeDisponivel');",
                  "    pm.expect(item).to.not.have.property('fornecedorId');",
                  "    pm.expect(item).to.have.property('disponivel');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET /public/produtos/{id} - sem header -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/produtos/{{produtoIdValido}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "produtos", "{{produtoIdValido}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sem quantidadeDisponivel exata nem fornecedorId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('quantidadeDisponivel');",
                  "  pm.expect(body).to.not.have.property('fornecedorId');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
